{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "averagedatabase",
  "main": "./app/server.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Keep dashboard plaintext vars. wrangler deploy deletes them otherwise.
  "keep_vars": true,
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/status/incident-report-april-1-2026-control-plane-degradation"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "average-database",
      "database_id": "273f98e4-b2ee-4829-9e27-1294335012e2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "average-database-uploads"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "routes": [
    { "pattern": "averagedatabase.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
